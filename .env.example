# YT Studio configuration. Copy to `.env` and edit as needed.
# Every variable is optional — defaults shown match what the app uses
# when the variable is missing. Prefix `YTS_` is required and read by
# pydantic-settings (see backend/app/config.py).

# ── Backend runtime ──────────────────────────────────────────────────
# Verbose SQL + reload behaviour. Set to false in any "production-like"
# setup (still local-host, but you don't want SQL echoed to logs).
YTS_DEBUG=true

# Bind address for uvicorn. Keep on 127.0.0.1 unless you specifically
# want LAN access — there's no auth in front of the API.
YTS_HOST=127.0.0.1
YTS_PORT=8000

# Where the frontend lives. Used for CORS allow-list and OAuth
# redirects after the YouTube callback completes.
YTS_FRONTEND_URL=http://localhost:5173

# ── External binaries ────────────────────────────────────────────────
# FFmpeg + ffprobe. Either put them on PATH or point to the absolute
# path here (e.g. C:\ffmpeg\bin\ffmpeg.exe).
YTS_FFMPEG_PATH=ffmpeg
YTS_FFPROBE_PATH=ffprobe

# Optional Node binary override for the visualizer engine sidecar.
# Empty = "whatever `node` resolves to on PATH".
YTS_NODE_PATH=

# Optional Claude Code CLI override. Empty = "whatever `claude`
# resolves to on PATH". Used for AI metadata generation against your
# Claude subscription credits (instead of paying per-token via API).
YTS_CLAUDE_CLI_PATH=

# ── External APIs ────────────────────────────────────────────────────
# YouTube Data API v3 key (server / "API key" type, NOT OAuth).
# Powers the keyword research panel — fetches trending videos and tag
# frequencies to feed the metadata prompt. Without it, research falls
# back to YouTube autocomplete only.
# Get one at: https://console.cloud.google.com → APIs & Services → Credentials.
YTS_YOUTUBE_API_KEY=

# All other API keys (Claude API, Suno, OpenAI for DALL·E, etc.) are
# entered through the Settings page in the UI and stored encrypted in
# data/studio.db — they don't belong in this file.
