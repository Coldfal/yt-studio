{
  "name": "visualizer-engine",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Node.js sidecar that renders Trap Nation / Specterr-style audio-reactive MP4 videos. Invoked by the Python backend as a one-shot subprocess.",
  "main": "dist/cli.js",
  "bin": {
    "visualizer-engine": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@napi-rs/canvas": "^1.0.11",
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
